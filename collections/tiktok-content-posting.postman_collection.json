          "name": "Init Video Upload",
          "request": {
            "name": "Init Video Upload",
            "description": {
              "content": "Initiates a video upload or direct post to a user's TikTok account. Declare the video source type (FILE_UPLOAD or PULL_FROM_URL), chunk count, file size, and publish metadata. Returns an upload_url and publish_id.",
